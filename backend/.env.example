# ============================================================
# 个人助手 harness 后端配置样例
# 复制为 backend/.env 后按需修改；所有项均可改，含默认值的项可省略
# ============================================================

# ============ LLM 接入（必填） ============
# Anthropic 兼容 API 密钥
ANTHROPIC_API_KEY=sk-xxx

# Anthropic 兼容 API 地址；留空用官方默认，MiniMax/GLM/Kimi 等兼容端点填其地址
ANTHROPIC_BASE_URL=

# 模型 ID（取决于你的兼容端点支持的模型）
MODEL_ID=claude-sonnet-4-20250514

# ============ 模型与运行参数（可选，含默认值） ============
# 单次回复最大 token 数
MAX_TOKENS=10000

# bash 工具单次执行超时（秒）
BASH_TIMEOUT=120

# 上下文窗口大小（token 数），用于 compact 阈值与前端进度显示
CONTEXT_WINDOW=1000000

# auto compact：输出预留（token）。阈值 = CONTEXT_WINDOW - COMPACT_OUTPUT_RESERVE - COMPACT_BUFFER
COMPACT_OUTPUT_RESERVE=32000

# auto compact：安全缓冲（token）
COMPACT_BUFFER=13000

# microcompact：保留完整输出的最近工具结果条数，更早的被占位符替换
MICROCOMPACT_KEEP=5

# ============ 服务（可选） ============
# 监听地址（无鉴权，务必保持仅本机）
HOST=127.0.0.1

# 监听端口
PORT=8000

# 数据目录根（SQLite/工作区/日志都在其下；相对路径基于 backend/）
DATA_DIR=data

# ============ 日志（可选） ============
# 控制台与文件日志级别：DEBUG / INFO / WARNING / ERROR
LOG_LEVEL=INFO

# ============ Langfuse 观测（可选，默认关闭） ============
# 是否启用 Langfuse 链路追踪（开启前先部署/注册 Langfuse 服务）
LANGFUSE_ENABLED=false

# Langfuse 服务地址（自部署填本地地址，云版填 https://cloud.langfuse.com）
LANGFUSE_BASE_URL=

# Langfuse 公钥
LANGFUSE_PUBLIC_KEY=

# Langfuse 私钥
LANGFUSE_SECRET_KEY=
